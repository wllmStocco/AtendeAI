# Copie para .env e preencha. Sem chaves, o projeto roda em modo dummy.
# NUNCA coloque o .env no zip/entrega nem cole a chave em chats ou prints.
LLM_MODE=dummy            # dummy | openai

# --- Opcao A: OpenAI (pago, pre-pago) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini  # confirme na pagina de modelos da OpenAI um modelo "mini" com tool calling
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Opcao B: Gemini (camada gratuita, endpoint compativel com OpenAI) ---
# OPENAI_API_KEY=<sua chave do Google AI Studio>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=<id de um modelo Flash listado no AI Studio>
# OPENAI_EMBEDDING_MODEL=<id de embedding da documentacao do Gemini>  # verificar antes da Fase 4

# Embeddings: por padrao seguem o LLM_MODE. Use hashing para nao gastar com embeddings (busca apenas lexical).
# EMBEDDINGS_MODE=hashing   # hashing | openai

# Verificacao de respostas (Fase 5)
NLI_MODE=auto             # auto | modelo | lexical
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# LangSmith (Fase 5). Ligue o tracing so ao rodar a avaliacao.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atendeai-disciplina-agents

# Forca o cache offline do ViaCEP (so o CEP 01310-100). Deixe vazio para usar a API real.
VIACEP_OFFLINE=
